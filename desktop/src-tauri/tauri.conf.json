{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salud Digital",
  "version": "1.0.0",
  "identifier": "com.saluddigital.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Salud Digital",
        "url": "index.html",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Medical",
    "copyright": "© Salud Digital",
    "shortDescription": "Plataforma clínica Salud Digital",
    "longDescription": "Aplicación de escritorio de la plataforma clínica Salud Digital: agenda, pacientes, consultas, finanzas y facturación.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
