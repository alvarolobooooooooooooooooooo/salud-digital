# App de escritorio (Tauri): el código vive en desktop/src y desktop/src-tauri,
# pero los artefactos de compilación pesan gigas y no van al repo.
desktop/node_modules/
desktop/src-tauri/target/
desktop/*.dmg

# Capturas y scripts de un solo uso
tools/shots/
tools/_*
.tmp-*
**/__preview.html

# Másteres de audio del launch: pesan 19 MB y son REGENERABLES con semilla
# fija (tools/gen-sfx.py y tools/gen-music.py). Lo que sirve la web son los
# .m4a, que sí van al repositorio. data-flow.wav es la excepción: es un
# bucle y necesita ir sin comprimir.
public/audio/sfx/*.wav
!public/audio/sfx/data-flow.wav
public/audio/launch-score.wav
